# Solo servidor: origen del backend. src/proxy.ts reescribe /api/v1/* a ${API_ORIGIN}/v1/*
# (P-1). Obligatoria sin mocks y al construir.
# Desarrollo: https://136.243.223.39.sslip.io
API_ORIGIN=

# Solo servidor (nunca NEXT_PUBLIC_): firma la IP del visitante para el backend (O1-OPS-1).
# El mismo valor que PROXY_SHARED_SECRET del backend de ese entorno. Vacía = sin firma, y el
# límite de peticiones del pasaporte público contaría por la IP de la plataforma.
PROXY_SHARED_SECRET=

# 1 = arranca MSW en el navegador (intercepta /api/v1/*) y sirve los datos de
# @drinks-on-chain/mocks. Con 1 no hace falta API_ORIGIN.
NEXT_PUBLIC_MOCKS=1

# Origen público de este sitio (sin barra final): URL canónicas y metadatos. Es el mismo valor
# que PASSPORT_BASE_URL del backend (la URL que llevan los QR). Vacío = sin URL canónica.
NEXT_PUBLIC_URL_APP=http://localhost:3005

# Otros sitios del ecosistema (enlaces cruzados). Vacío = el enlace no se muestra.
NEXT_PUBLIC_URL_LANDING=https://drinks-on-chain-landing.vercel.app
NEXT_PUBLIC_URL_BODEGAS=https://drinks-on-chain-bodegas.vercel.app
